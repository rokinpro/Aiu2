# All values remain server-side. Only AIU2_INGEST_TOKEN is required for ingestion.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL_ID=
AIU2_API_URL=
AIU2_INGEST_TOKEN=
SERIAL_PORT=
SERIAL_BAUD=
DATABASE_URL=
# Optional SQLite path (default: data/aiu2.sqlite)
AIU2_DB_PATH=
# Calibrate against your actual fixed sensor geometry (default: 30 cm)
AIU2_FOREGROUND_CM=
# Set true when hosted over HTTPS
AIU2_SECURE_COOKIES=
